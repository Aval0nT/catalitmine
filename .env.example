# Copy this file to `.env` and fill in your own API keys.
# `.env` is git-ignored; never commit real keys.

# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key for Claude-based evidence extraction.
# Sign up: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Required for Phase 0 (Discovery & Acquisition) ──────────────────────────
# Used as the identifier in OpenAlex polite-pool requests and required by
# the Unpaywall API. Any working email is fine.
OPENALEX_EMAIL=you@example.com
UNPAYWALL_EMAIL=you@example.com

# ── Optional ────────────────────────────────────────────────────────────────
# Semantic Scholar API key for higher rate limits during corpus expansion.
# Without it, the public 1-req/s limit still works for small-scale runs.
# Apply: https://www.semanticscholar.org/product/api
S2_API_KEY=

# Override the Claude model used for LLM relevance scoring in discover.py.
# Defaults to claude-haiku-4-5; use claude-sonnet-4-5 for higher quality
# at ~10× the cost.
CATALITMINE_LLM_MODEL=

# Zotero integration for library management scripts (scripts/zotero/*).
# Personal-library write access.
# Get user ID and API key: https://www.zotero.org/settings/keys
ZOTERO_API_KEY=
ZOTERO_USER_ID=
